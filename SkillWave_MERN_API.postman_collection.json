            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "var token = jsonData.token || (jsonData.data && jsonData.data.token);",
                  "pm.test(\"Has token\", function () { pm.expect(token).to.not.be.empty; });",
                  "if (token) { pm.collectionVariables.set(\"authToken\", token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"teacher@skillwave.edu\",\n  \"password\": \"Teacher@123\"\n}"
